    m_MaxSize: 40
    m_Alignment: 6
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "WASD - \u0445\u043E\u0434\u0438\u0442\u044C, \u043C\u044B\u0448\u044C
    - \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u041F\u0440\u043E\u0431\u0435\u043B
    - \u043F\u0440\u044B\u0436\u043E\u043A, E - \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
    \u0438 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F,
    \u041B\u041A\u041C - \u0443\u0434\u0430\u0440 \u043F\u043E\u0441\u043E\u0445\u043E\u043C,
    Esc - \u043F\u0430\u0443\u0437\u0430.\n\u0414\u0435\u0440\u0435\u0432\u043D\u044F:
    \u043F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0435
    \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0442\u0440\u0438 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430.
    \u0411\u0430\u0448\u043D\u044F: \u0437\u0430\u0436\u0433\u0438\u0442\u0435 \u0436\u0430\u0440\u043E\u0432\u043D\u0438
    \u0438 \u043F\u0440\u043E\u0433\u043E\u043D\u0438\u0442\u0435 \u0441\u043B\u0438\u0437\u043D\u0435\u0439
    \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430."
