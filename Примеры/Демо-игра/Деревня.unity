  m_Text: "WASD - \u0445\u043E\u0434\u0438\u0442\u044C, \u043C\u044B\u0448\u044C
    - \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u041F\u0440\u043E\u0431\u0435\u043B
    - \u043F\u0440\u044B\u0436\u043E\u043A, E - \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
    \u0438\u043B\u0438 \u043D\u0430\u0436\u0430\u0442\u044C.\n\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435
    \u043A \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0435 \u0443 \u0434\u043E\u043C\u0430
    \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 E"
