    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 6
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041B\u041A\u041C - \u0443\u0434\u0430\u0440 \u043F\u043E\u0441\u043E\u0445\u043E\u043C.
    \u041F\u043B\u0438\u0442\u044B \u043D\u0430\u0434 \u043B\u0430\u0432\u043E\u0439
    \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F,
    \u0435\u0441\u043B\u0438 \u043D\u0430 \u043D\u0438\u0445 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F!\n\u0417\u0430\u0436\u0433\u0438\u0442\u0435
    \u0436\u0430\u0440\u043E\u0432\u043D\u0438 (E) \u0438 \u043F\u0440\u043E\u0433\u043E\u043D\u0438\u0442\u0435
    \u0441\u043B\u0438\u0437\u043D\u0435\u0439 \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
