    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 20
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 6
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u0432\u0435
    \u043A\u043E\u043F\u0438\u0438 \u0438\u0433\u0440\u044B (\u0438\u043B\u0438 \u0438\u0433\u0440\u0443
    \u0438 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440). \u0412 \u043E\u0434\u043D\u043E\u0439
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0421\u043E\u0437\u0434\u0430\u0442\u044C
    \u0438\u0433\u0440\u0443\xBB, \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 - \xAB\u041D\u0430\u0439\u0442\u0438
    \u0438\u0433\u0440\u0443\xBB \u0438\u043B\u0438 \u0432\u0432\u0435\u0434\u0438\u0442\u0435
    \u0430\u0434\u0440\u0435\u0441. \u0414\u043B\u044F \u0438\u0433\u0440\u044B \u0447\u0435\u0440\u0435\u0437
    \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
    Radmin VPN: \u0430\u0434\u0440\u0435\u0441 \u0431\u0443\u0434\u0435\u0442 \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C\u0441\u044F
    \u0441 26"
